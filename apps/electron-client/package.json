{
  "name": "electron-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "npx cross-env NODE_ENV=development npx concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:addon": "node-gyp configure build",
    "build:renderer": "npm run --workspace=renderer build",
    "build": "npm run build:renderer && npm run build:addon"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chardet": "^2.1.0",
    "electron": "^29.4.6",
    "electron-store": "^7.0.3",
    "emailjs-mime-parser": "^2.0.7",
    "googleapis": "^148.0.0",
    "iconv-lite": "^0.6.3",
    "mailparser": "^3.7.2",
    "node-imap": "^0.9.6",
    "nodemailer": "^6.10.1",
    "quoted-printable": "^1.0.1",
    "sqlite3": "^5.1.7",
    "node-addon-api": "^8.3.1",
    "node-gyp": "^11.2.0"
  },
  "devDependencies": {
    "vite": "^6.3.1",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "wait-on": "^8.5.1"
  }
}
